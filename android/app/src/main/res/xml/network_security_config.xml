<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http only to the app itself: the photo checks' web view talks to a
     server inside the app on 127.0.0.1 (lib/services/moderation_io.dart). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
